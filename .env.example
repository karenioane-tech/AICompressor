# Flask Environment (development or production)
FLASK_ENV=development

# Port (Render will set this automatically in production)
PORT=5000

# Upload and compression folder paths
UPLOAD_FOLDER=uploads
COMPRESSED_FOLDER=compressed

# File retention time in seconds (default: 3600 = 1 hour)
FILE_RETENTION_SECONDS=3600

# Maximum upload size in bytes (default: 52428800 = 50 MB)
MAX_UPLOAD_SIZE=52428800
